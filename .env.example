# Backend Environment Variables

# MongoDB Connection String
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/cybernaut

# For MongoDB Atlas (cloud):
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/cybernaut?retryWrites=true&w=majority

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000

# Optional: API Rate Limiting (not currently implemented)
# RATE_LIMIT_WINDOW=15m
# RATE_LIMIT_MAX_REQUESTS=100

# Optional: CORS Configuration
# ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000
